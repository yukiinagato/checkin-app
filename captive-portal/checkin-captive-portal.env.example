# Create /etc/checkin-captive-portal.env with mode 0600.
# FAS_KEY must exactly match option faskey in /etc/config/opennds on the router.
FAS_KEY=replace-with-a-64-character-random-secret
HOST=127.0.0.1
PORT=3012
AUTH_DIR=/var/lib/checkin-captive-portal/auth
# Read-only source used after network authorisation to decide whether the guest
# should be guided to complete registration. A lookup failure never blocks Wi-Fi.
CHECKIN_DB_PATH=/root/checkin-app/server/data/hotel.db
